  create  table "job_pipeline"."public"."int_job_skills_exploded__dbt_tmp"
  
  
    as
  
  (
    

WITH staging_data AS (
    SELECT * FROM "job_pipeline"."public_staging"."stg_job_postings"
    WHERE skills IS NOT NULL AND skills != ''
), -- Make sure this comma is here

exploded_skills AS (
    SELECT
        job_id,
        -- PostgreSQL function to split strings into rows
        TRIM(UNNEST(STRING_TO_ARRAY(skills, ','))) AS skill_name
    FROM staging_data
) -- NO comma here before the final SELECT

SELECT 
    -- dbt_utils macro to generate a unique ID
    md5(cast(coalesce(cast(job_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(skill_name as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS job_skill_id,
    job_id,
    skill_name
FROM exploded_skills
  );
  
