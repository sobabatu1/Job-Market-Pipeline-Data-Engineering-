  create  table "job_pipeline"."public"."int_job_skills_exploded__dbt_tmp"
  
  
    as
  
  (
    

WITH staging_data AS (
    SELECT 
        job_id,
        job_title,
        skills_raw
    FROM "job_pipeline"."public_staging"."stg_job_postings"
    -- Filter out any rows that have no skills listed
    WHERE skills_raw IS NOT NULL
),

exploded_skills AS (
    SELECT
        job_id,
        job_title,
        -- This PostgreSQL function splits the string and turns it into rows
        TRIM(UNNEST(STRING_TO_ARRAY(skills_raw, ','))) AS skill_name
    FROM staging_data
)

SELECT 
    -- Generate a unique hash for this combination of job and skill
    md5(cast(coalesce(cast(job_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(skill_name as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS job_skill_id,
    job_id,
    job_title,
    skill_name
FROM exploded_skills
  );
  
