  create  table "job_pipeline"."public"."int_job_skills_exploded__dbt_tmp"
  
  
    as
  
  (
    

WITH staging_data AS (
    SELECT 
        job_id,
        job_title,
        skills_raw
    FROM "job_pipeline"."public_staging"."stg_job_postings"
    -- Filter out any rows that have no skills listed
    WHERE skills_raw IS NOT NULL
),



SELECT
    -- Generate a unique Surrogate Key for every Job-Skill pair
    md5(cast(coalesce(cast(job_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(skill_name as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS sk_id,
    job_id,
    -- Split comma-separated string into individual rows
    TRIM(UNNEST(STRING_TO_ARRAY(skills, ','))) AS skill_name
FROM "job_pipeline"."public_staging"."stg_job_postings"
WHERE skills IS NOT NULL AND skills != ''
  );
  
