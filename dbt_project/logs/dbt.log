  create  table "job_pipeline"."public_marts"."mart_job_market_insights__dbt_tmp"
  
  
    as
  
  (
    

SELECT 
    skill_name,
    COUNT(DISTINCT job_id) AS demand_count,
    ROUND(AVG((salary_min + salary_max) / 2), 2) AS avg_market_salary,
    -- Calculate what % of these jobs are remote
    ROUND(100.0 * COUNT(CASE WHEN is_remote THEN 1 END) / COUNT(*), 2) AS remote_pct
FROM "job_pipeline"."public"."int_job_skills_exploded"
JOIN "job_pipeline"."public_staging"."stg_job_postings" USING (job_id)
GROUP BY 1
HAVING COUNT(DISTINCT job_id) > 5 -- Filter out outliers
ORDER BY demand_count DESC
  );
  
