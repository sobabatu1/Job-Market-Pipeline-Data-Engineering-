[0m14:55:31.668171 [debug] [Thread-1  ]: On model.job_market_pipeline.stg_job_postings: /* {"app": "dbt", "dbt_version": "1.9.0b2", "profile_name": "job_market_pipeline", "target_name": "dev", "node_id": "model.job_market_pipeline.stg_job_postings"} */

  create view "job_pipeline"."public_staging"."stg_job_postings__dbt_tmp"
    
    
  as (
    

WITH raw_data AS (
    SELECT * FROM "job_pipeline"."raw"."job_postings"
),

deduped AS (
    -- Remove duplicates based on title, company, and date
    SELECT *,
           ROW_NUMBER() OVER (
               PARTITION BY title, company_name, posted_date 
               ORDER BY job_id DESC
           ) as rn
    FROM raw_data
),

final AS (
    SELECT
        job_id,
        TRIM(title) AS job_title,
        TRIM(company_name) AS company,
        LOWER(location) AS location,
        CAST(salary_min AS NUMERIC) AS salary_min,
        CAST(salary_max AS NUMERIC) AS salary_max,
        CAST(posted_date AS DATE) AS date_priority,
        -- Business Logic: Flagging Remote Roles
        CASE WHEN location LIKE '%remote%' THEN TRUE ELSE FALSE END AS is_remote
    FROM deduped
    WHERE rn = 1 -- Only keep the most recent version of a job
)

SELECT * FROM final
  );
