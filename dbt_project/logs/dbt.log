  create  table "job_pipeline"."public_marts"."mart_job_market_insights__dbt_tmp"
  
  
    as
  
  (
    

WITH skills_data AS (
    SELECT 
        skill_name,
        job_id
    FROM "job_pipeline"."public"."int_job_skills_exploded"
),

job_postings AS (
    SELECT 
        job_id,
        salary_min,
        salary_max,
        (salary_min + salary_max) / 2 AS salary_avg,
        is_remote
    FROM "job_pipeline"."public_staging"."stg_job_postings"
),

final_metrics AS (
    SELECT 
        s.skill_name,
        COUNT(DISTINCT s.job_id) AS total_postings,
        ROUND(AVG(j.salary_avg), 2) AS avg_salary,
        COUNT(DISTINCT CASE WHEN j.is_remote THEN s.job_id END) AS remote_postings
    FROM skills_data s
    JOIN job_postings j ON s.job_id = j.job_id
    GROUP BY 1
)

SELECT 
    *,
