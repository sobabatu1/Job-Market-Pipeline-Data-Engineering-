  create view "job_pipeline"."public_staging"."stg_job_postings__dbt_tmp"
    
    
  as (
    

WITH raw_data AS (
    SELECT * FROM "job_pipeline"."raw"."job_postings"
),

cleaned_data AS (
    SELECT
        job_id,
        TRIM(title) AS job_title,
        TRIM(company_name) AS company_name,
        TRIM(location) AS job_location,
        experience_level,
        -- Handle potential empty strings or bad data in numeric columns
        CAST(NULLIF(TRIM(CAST(salary_min AS TEXT)), '') AS NUMERIC) AS salary_min,
        CAST(NULLIF(TRIM(CAST(salary_max AS TEXT)), '') AS NUMERIC) AS salary_max,
        CAST(posted_date AS DATE) AS posted_date,
        TRIM(skills) AS skills_raw,
        -- Create a boolean flag for remote roles
        CASE 
            WHEN LOWER(location) LIKE '%remote%' THEN TRUE 
            ELSE FALSE 
        END AS is_remote
    FROM raw_data
)

SELECT * FROM cleaned_data
  );
