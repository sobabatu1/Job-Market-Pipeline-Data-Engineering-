{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.12.0b1", "generated_at": "2026-05-21T16:55:52.394756Z", "invocation_id": "4810dcd3-3a10-405e-8456-5566271eca2f", "invocation_started_at": "2026-05-21T16:55:44.653177Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-21T16:55:46.111203Z", "completed_at": "2026-05-21T16:55:46.116534Z"}, {"name": "execute", "started_at": "2026-05-21T16:55:46.116743Z", "completed_at": "2026-05-21T16:55:46.202202Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.09171199798583984, "adapter_response": {"_message": "CREATE VIEW", "code": "CREATE VIEW", "rows_affected": -1}, "message": "CREATE VIEW", "failures": null, "unique_id": "model.job_market_pipeline.stg_job_postings", "compiled": true, "compiled_code": "\n\nWITH raw_data AS (\n    SELECT * FROM \"job_pipeline\".\"raw\".\"job_postings\"\n),\n\nfinal AS (\n    SELECT\n        job_id,\n        TRIM(title) AS job_title,\n        company_name,\n        location,\n        skills, \n        CAST(salary_min AS NUMERIC) AS salary_min,\n        CAST(salary_max AS NUMERIC) AS salary_max,\n        CAST(posted_date AS DATE) AS posted_date,\n        -- ADD THIS LOGIC HERE:\n        CASE \n            WHEN LOWER(location) LIKE '%remote%' THEN TRUE \n            ELSE FALSE \n        END AS is_remote\n    FROM raw_data\n)\n\nSELECT * FROM final", "relation_name": "\"job_pipeline\".\"public_staging\".\"stg_job_postings\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-21T16:55:46.205383Z", "completed_at": "2026-05-21T16:55:46.207925Z"}, {"name": "execute", "started_at": "2026-05-21T16:55:46.208123Z", "completed_at": "2026-05-21T16:55:51.299885Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 5.095767021179199, "adapter_response": {"_message": "SELECT 1251358", "code": "SELECT", "rows_affected": 1251358}, "message": "SELECT 1251358", "failures": null, "unique_id": "model.job_market_pipeline.int_job_skills_exploded", "compiled": true, "compiled_code": "\n\n-- CTE 1: Get data from staging\nWITH staging_data AS (\n    SELECT \n        job_id,\n        skills \n    FROM \"job_pipeline\".\"public_staging\".\"stg_job_postings\"\n    WHERE skills IS NOT NULL \n      AND skills != ''\n), -- <-- THIS COMMA IS MANDATORY\n\n-- CTE 2: Break the strings apart\nexploded_skills AS (\n    SELECT\n        job_id,\n        TRIM(UNNEST(STRING_TO_ARRAY(skills, ','))) AS skill_name\n    FROM staging_data\n) -- <-- NO COMMA HERE\n\n-- Final Output\nSELECT \n    md5(cast(coalesce(cast(job_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(skill_name as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) AS job_skill_id,\n    job_id,\n    skill_name\nFROM exploded_skills", "relation_name": "\"job_pipeline\".\"public\".\"int_job_skills_exploded\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-21T16:55:51.304105Z", "completed_at": "2026-05-21T16:55:51.306496Z"}, {"name": "execute", "started_at": "2026-05-21T16:55:51.306702Z", "completed_at": "2026-05-21T16:55:52.383401Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 1.0800697803497314, "adapter_response": {"_message": "SELECT 10", "code": "SELECT", "rows_affected": 10}, "message": "SELECT 10", "failures": null, "unique_id": "model.job_market_pipeline.mart_job_market_insights", "compiled": true, "compiled_code": "\n\nSELECT \n    skills.skill_name,\n    COUNT(DISTINCT skills.job_id) AS demand_count,\n    ROUND(AVG((stg.salary_min + stg.salary_max) / 2), 2) AS avg_market_salary,\n    -- This is the line that was failing:\n    ROUND(100.0 * COUNT(CASE WHEN stg.is_remote THEN 1 END) / COUNT(*), 2) AS remote_pct\nFROM \"job_pipeline\".\"public\".\"int_job_skills_exploded\" AS skills\nJOIN \"job_pipeline\".\"public_staging\".\"stg_job_postings\" AS stg \n    ON skills.job_id = stg.job_id\nGROUP BY 1\nHAVING COUNT(DISTINCT skills.job_id) > 5\nORDER BY demand_count DESC", "relation_name": "\"job_pipeline\".\"public_marts\".\"mart_job_market_insights\"", "batch_results": null, "overload_results": null}], "elapsed_time": 6.488893985748291, "args": {"require_valid_schema_from_generate_schema_name": false, "support_custom_ref_kwargs": false, "require_corrected_analysis_fqns": false, "require_resource_names_without_spaces": true, "defer": false, "require_all_warnings_handled_by_warn_error": false, "use_colors_file": true, "cache_selected_only": false, "show_all_deprecations": false, "send_anonymous_usage_stats": true, "quiet": false, "require_batched_execution_for_custom_microbatch_strategy": false, "vars": {}, "state_modified_compare_vars": false, "state_modified_compare_more_unrendered_values": false, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "static_parser": true, "favor_state": false, "print": true, "printer_width": 80, "show_resource_report": false, "require_yaml_configuration_for_mf_time_spines": false, "require_ref_searches_node_package_before_root": false, "macro_debugging": false, "log_format": "default", "warn_error_options": {"error": [], "warn": [], "silence": []}, "invocation_command": "dbt run", "profiles_dir": "/Users/lbaba/job_market_pipeline/dbt_project", "allow_jinja_file_extensions": false, "partial_parse_file_diff": true, "skip_nodes_if_on_run_start_fails": false, "project_dir": "/Users/lbaba/job_market_pipeline/dbt_project", "source_freshness_run_project_hooks": true, "require_source_and_semantic_model_names_without_spaces": false, "require_explicit_package_overrides_for_builtin_materializations": true, "log_file_max_bytes": 10485760, "introspect": true, "log_format_file": "debug", "require_sql_header_in_test_configs": false, "use_fast_test_edges": false, "log_level": "info", "version_check": true, "partial_parse": true, "log_path": "/Users/lbaba/job_m